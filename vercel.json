{
  "version": 2,
  "name": "edusphere-frontend",
  "builds": [
    {
      "src": "SE Project (2)/SE Project/New folder/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/js/(.*)",
      "dest": "/SE Project (2)/SE Project/New folder/js/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/SE Project (2)/SE Project/New folder/css/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/SE Project (2)/SE Project/New folder/assets/$1"
    },
    {
      "src": "/Classes & Sections/(.*)",
      "dest": "/SE Project (2)/SE Project/New folder/Classes & Sections/$1"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/SE Project (2)/SE Project/New folder/$1"
    },
    {
      "src": "/",
      "dest": "/SE Project (2)/SE Project/New folder/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/SE Project (2)/SE Project/New folder/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection",        "value": "1; mode=block" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Expires",       "value": "0" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
