# Auto-detect text files and normalize line endings
* text=auto

# Force LF for web files
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.env  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.prisma text eol=lf

# Binary files — no conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.xlsx binary
*.pdf  binary
