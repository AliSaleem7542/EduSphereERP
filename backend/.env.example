# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local:   postgresql://postgres:password@localhost:5432/edusphere_db
# Render:  postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edusphere_db"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT Secrets (change these in production!) ───────────────────────────────
JWT_ACCESS_SECRET=edusphere_access_secret_key_2025_change_in_production
JWT_REFRESH_SECRET=edusphere_refresh_secret_key_2025_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:8080

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
