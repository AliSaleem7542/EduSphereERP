# ─── Neon PostgreSQL ─────────────────────────────────────────────────────────
#
# Get both URLs from: https://console.neon.tech
#   → Your Project → Connection Details → Connection string
#
# DATABASE_URL  = Pooled connection (pgbouncer=true) — used at runtime
# DIRECT_URL    = Direct connection — used by Prisma migrations
#
# ⚠️  IMPORTANT: Both URLs MUST include ?sslmode=require for Neon to work
#
# Example Neon URLs:
# DATABASE_URL="postgresql://user:pass@ep-xxx-yyy.us-east-2.aws.neon.tech/edusphere?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://user:pass@ep-xxx-yyy.us-east-2.aws.neon.tech/edusphere?sslmode=require&connect_timeout=15"
#
# If you only have ONE connection string (no pgbouncer), use it for both:
# DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/edusphere?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/edusphere?sslmode=require"
#
# Local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edusphere_db"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/edusphere_db"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# Generate strong secrets for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=edusphere_access_secret_key_2025_change_in_production
JWT_REFRESH_SECRET=edusphere_refresh_secret_key_2025_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Add your Vercel frontend URL after deployment
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:8080
# Production: ALLOWED_ORIGINS=https://your-app.vercel.app

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
