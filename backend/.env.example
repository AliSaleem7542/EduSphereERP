# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Get these from: https://console.neon.tech → your project → Connection Details
#
# DATABASE_URL  = pooled connection (used by Prisma at runtime)
# DIRECT_URL    = direct connection (used by Prisma migrations)
#
# Local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edusphere_db"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/edusphere_db"
#
# Neon production (replace with your actual values):
# DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/edusphere?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/edusphere?sslmode=require"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# On Render: NODE_ENV=production (set in dashboard)

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# IMPORTANT: Use strong random secrets in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=edusphere_access_secret_key_2025_change_in_production
JWT_REFRESH_SECRET=edusphere_refresh_secret_key_2025_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Add your Vercel frontend URL here after deployment
# Example: https://edusphere-erp.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:8080
# Production example:
# ALLOWED_ORIGINS=https://edusphere-erp.vercel.app,https://alisaleem7542.github.io

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
